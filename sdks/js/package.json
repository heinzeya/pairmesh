{
  "name": "@pairmesh/js",
  "version": "0.1.0",
  "description": "Pair browsers with a QR code and send plugin commands between them over PairMesh.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "unpkg": "./dist/pairmesh.global.js",
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "phoenix": "1.8.16",
    "qrcode-generator": "^1.4.4"
  },
  "devDependencies": {
    "@types/phoenix": "^1.6.6",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
